---
import BaseLayout from '../layouts/BaseLayout.astro';
import InteractivePassDemo from '../components/InteractivePassDemo';
---

<BaseLayout isMarketing={true}>
  <!-- =====================================================================
       1. HERO SECTION — MISMO DISEÑO ORIGINAL, MENSAJE CLARO Y DIRECTO
       ===================================================================== -->
  <section class="mx-auto grid w-full max-w-6xl gap-10 px-5 pb-16 pt-10 md:grid-cols-[minmax(0,7fr)_minmax(0,5fr)] md:items-center md:pt-24">
    <div class="min-w-0">
      <p class="mb-3 inline-flex items-center rounded-full bg-accent-soft px-3 py-1 text-xs font-medium text-accent-strong">
        Para cafeterías, barberías, restaurantes y negocios locales
      </p>
      <h1 class="max-w-[16ch] text-5xl font-semibold leading-[1.04] tracking-tight [overflow-wrap:anywhere] md:text-6xl">
        Haz que tus clientes regresen con una tarjeta de sellos en su celular.
      </h1>
      <p class="mt-5 max-w-prose text-lg text-ink-soft">
        Escanean tu QR en mostrador, guardan su tarjeta en Apple Wallet o Google Wallet sin instalar apps y suman sellos en cada compra.
      </p>
      <div class="mt-8 flex flex-wrap items-center gap-5">
        <a
          class="inline-flex h-12 items-center rounded-full bg-ink px-6 text-base font-medium text-cream transition-colors hover:bg-black"
          href="/login"
        >
          Configura tu negocio
        </a>
        <a
          href="#como-funciona"
          class="text-sm font-medium text-ink-soft underline decoration-line underline-offset-4 transition-colors hover:text-ink"
        >
          Ver cómo funciona
        </a>
      </div>

      <!-- Resumen visual de 3 puntos sin párrafos largos -->
      <div class="mt-10 grid grid-cols-3 gap-4 border-t border-line pt-6 text-sm">
        <div>
          <p class="font-semibold text-ink">Sin bajar apps</p>
          <p class="text-xs text-ink-muted">Directo en su teléfono</p>
        </div>
        <div>
          <p class="font-semibold text-ink">Sin aparatos</p>
          <p class="text-xs text-ink-muted">Con cualquier celular</p>
        </div>
        <div>
          <p class="font-semibold text-ink">$500 MXN / mes</p>
          <p class="text-xs text-ink-muted">Todo ilimitado</p>
        </div>
      </div>
    </div>

    <div class="flex justify-start md:justify-end">
      <InteractivePassDemo client:load />
    </div>
  </section>

  <!-- =====================================================================
       2. CÓMO FUNCIONA — 5 PASOS VISUALES + QUIÉN HACE QUÉ + MENOS TEXTO
       ===================================================================== -->
  <div id="como-funciona" class="mx-auto w-full max-w-6xl px-5">
    <!-- PASO 1 -->
    <section class="mk-stage grid gap-8 py-12 md:grid-cols-[minmax(0,2fr)_minmax(0,5fr)_minmax(0,4fr)] md:gap-10 md:py-16">
      <div>
        <p class="text-sm font-medium text-ink-muted">
          01 — <span class="text-accent-strong">Configura</span>
        </p>
        <span class="mt-2 inline-block rounded-full bg-accent-soft px-2.5 py-0.5 text-xs font-medium text-accent-strong">
          Lo hace tu negocio
        </span>
      </div>
      <div class="min-w-0">
        <h2 class="text-2xl font-semibold tracking-tight md:text-3xl">
          1. Configuras tu premio en 2 minutos.
        </h2>
        <p class="mt-2 max-w-prose text-ink-soft">
          Subes tu logo, eliges colores, número de sellos y recompensa. Recibes tu enlace propio y un PIN para tus empleados.
        </p>
      </div>
      <div class="flex min-w-0 md:justify-end">
        <figure class="w-full max-w-xs rounded-card border border-line bg-paper p-5" aria-label="Vista previa de configuración">
          <p class="text-xs font-medium uppercase tracking-wide text-ink-muted">Tu URL</p>
          <p class="mt-1 font-mono text-sm">
            loyalty.grunagency.com/<span class="rounded bg-accent-soft px-1 text-accent-strong">tu-negocio</span>
          </p>
          <p class="mt-5 text-xs font-medium uppercase tracking-wide text-ink-muted">PIN de Empleados</p>
          <p class="mt-2 font-mono text-2xl leading-none tracking-[0.3em]">••••••</p>
        </figure>
      </div>
    </section>

    <!-- PASO 2 -->
    <section class="mk-stage grid gap-8 py-12 md:grid-cols-[minmax(0,2fr)_minmax(0,5fr)_minmax(0,4fr)] md:gap-10 md:py-16">
      <div>
        <p class="text-sm font-medium text-ink-muted">
          02 — <span class="text-accent-strong">Imprime</span>
        </p>
        <span class="mt-2 inline-block rounded-full bg-accent-soft px-2.5 py-0.5 text-xs font-medium text-accent-strong">
          En tu mostrador
        </span>
      </div>
      <div class="min-w-0">
        <h2 class="text-2xl font-semibold tracking-tight md:text-3xl">
          2. Colocas tu cartel QR en caja.
        </h2>
        <p class="mt-2 max-w-prose text-ink-soft">
          Grün genera automáticamente el cartel con tu marca listo para imprimir y poner en tu mostrador.
        </p>
      </div>
      <div class="flex min-w-0 md:justify-end">
        <figure class="w-56 rounded-2xl bg-accent p-5 text-center text-accent-ink" aria-label="Vista previa del cartel">
          <p class="text-lg font-semibold leading-tight">Premio o servicio gratis</p>
          <p class="mt-1 text-xs opacity-90">Acumula 10 sellos</p>
          <span
            class="grid gap-px bg-white mx-auto mt-4 h-24 w-24 rounded-lg p-2"
            style="grid-template-columns:repeat(8, minmax(0, 1fr))"
            aria-hidden="true"
          >
            <span class="bg-ink"></span><span class="bg-white"></span><span class="bg-white"></span><span class="bg-ink"></span><span class="bg-white"></span><span class="bg-ink"></span><span class="bg-ink"></span><span class="bg-white"></span>
            <span class="bg-ink"></span><span class="bg-ink"></span><span class="bg-ink"></span><span class="bg-white"></span><span class="bg-ink"></span><span class="bg-ink"></span><span class="bg-white"></span><span class="bg-ink"></span>
            <span class="bg-white"></span><span class="bg-white"></span><span class="bg-ink"></span><span class="bg-white"></span><span class="bg-ink"></span><span class="bg-ink"></span><span class="bg-white"></span><span class="bg-ink"></span>
            <span class="bg-ink"></span><span class="bg-ink"></span><span class="bg-white"></span><span class="bg-ink"></span><span class="bg-ink"></span><span class="bg-white"></span><span class="bg-ink"></span><span class="bg-white"></span>
            <span class="bg-white"></span><span class="bg-ink"></span><span class="bg-white"></span><span class="bg-ink"></span><span class="bg-ink"></span><span class="bg-white"></span><span class="bg-ink"></span><span class="bg-ink"></span>
            <span class="bg-ink"></span><span class="bg-white"></span><span class="bg-ink"></span><span class="bg-ink"></span><span class="bg-white"></span><span class="bg-ink"></span><span class="bg-white"></span><span class="bg-white"></span>
            <span class="bg-ink"></span><span class="bg-white"></span><span class="bg-ink"></span><span class="bg-ink"></span><span class="bg-white"></span><span class="bg-ink"></span><span class="bg-ink"></span><span class="bg-ink"></span>
            <span class="bg-white"></span><span class="bg-ink"></span><span class="bg-ink"></span><span class="bg-white"></span><span class="bg-ink"></span><span class="bg-white"></span><span class="bg-white"></span><span class="bg-ink"></span>
          </span>
          <p class="mt-3 text-[11px] leading-snug opacity-90">
            Escanea para agregar a Apple o Google Wallet.
          </p>
        </figure>
      </div>
    </section>

    <!-- PASO 3 -->
    <section class="mk-stage grid gap-8 py-12 md:grid-cols-[minmax(0,2fr)_minmax(0,5fr)_minmax(0,4fr)] md:gap-10 md:py-16">
      <div>
        <p class="text-sm font-medium text-ink-muted">
          03 — <span class="text-accent-strong">Guarda</span>
        </p>
        <span class="mt-2 inline-block rounded-full border border-line bg-surface-muted px-2.5 py-0.5 text-xs font-medium text-ink-soft">
          Lo hace tu cliente
        </span>
      </div>
      <div class="min-w-0">
        <h2 class="text-2xl font-semibold tracking-tight md:text-3xl">
          3. El cliente escanea el QR y guarda su tarjeta.
        </h2>
        <p class="mt-2 max-w-prose text-ink-soft">
          Con la cámara de su celular la guarda al instante en Apple Wallet, Google Wallet o en su navegador web. Sin formularios ni descargas.
        </p>
      </div>
      <div class="flex min-w-0 md:justify-end">
        <figure class="w-full max-w-xs rounded-card border border-line bg-paper p-5" aria-label="Guardado en un toque">
          <div class="flex items-center justify-between text-xs text-ink-muted">
            <span>TARJETA DIGITAL</span>
            <span class="font-mono text-accent-strong">1 TOQUE</span>
          </div>
          <div class="mt-3 space-y-2 text-xs font-medium">
            <div class="flex items-center justify-between rounded-xl bg-ink px-3.5 py-2.5 text-cream">
              <span>Apple Wallet (iPhone)</span>
              <span>Guardar →</span>
            </div>
            <div class="flex items-center justify-between rounded-xl border border-line bg-surface-muted px-3.5 py-2.5 text-ink">
              <span>Google Wallet / Web</span>
              <span>Guardar →</span>
            </div>
          </div>
        </figure>
      </div>
    </section>

    <!-- PASO 4 (CON LAS 2 MODALIDADES DE SELLADO CLARAS) -->
    <section class="mk-stage grid gap-8 py-12 md:grid-cols-[minmax(0,2fr)_minmax(0,5fr)_minmax(0,4fr)] md:gap-10 md:py-16">
      <div>
        <p class="text-sm font-medium text-ink-muted">
          04 — <span class="text-accent-strong">Sella</span>
        </p>
        <span class="mt-2 inline-block rounded-full bg-accent-soft px-2.5 py-0.5 text-xs font-medium text-accent-strong">
          Empleado o Cliente
        </span>
      </div>
      <div class="min-w-0">
        <h2 class="text-2xl font-semibold tracking-tight md:text-3xl">
          4. Suma sellos en 2 segundos al comprar.
        </h2>
        <p class="mt-2 max-w-prose text-ink-soft">
          Elige cómo sellar en tu local:
        </p>
        <div class="mt-4 grid gap-3 sm:grid-cols-2">
          <div class="rounded-2xl border border-line bg-surface-muted p-3.5 text-sm">
            <p class="font-semibold text-ink">Modo A · Empleado escanea</p>
            <p class="mt-1 text-xs text-ink-soft">
              Tu personal entra con PIN en cualquier celular, escanea la tarjeta del cliente y toca <strong>+1 sello</strong>.
            </p>
          </div>
          <div class="rounded-2xl border border-line bg-surface-muted p-3.5 text-sm">
            <p class="font-semibold text-ink">Modo B · Cliente escanea</p>
            <p class="mt-1 text-xs text-ink-soft">
              El cliente escanea el QR del mostrador al pagar (con bloqueo de tiempo antifraude).
            </p>
          </div>
        </div>
      </div>
      <div class="flex min-w-0 md:justify-end">
        <figure class="w-full max-w-xs rounded-card border border-line bg-paper p-5" aria-label="Vista previa del escáner">
          <div class="flex items-center justify-between">
            <p class="font-mono tracking-[0.2em]">ABCD-2345</p>
            <p class="text-2xl font-semibold">
              6<span class="text-sm text-ink-muted"> / 10</span>
            </p>
          </div>
          <div class="mt-3">
            <div
              class="grid gap-2"
              style="grid-template-columns:repeat(5, minmax(0, 1fr))"
              role="img"
              aria-label="6 de 10 sellos"
            >
              <span aria-hidden="true" class="flex h-6 w-6 items-center justify-center rounded-full border-2" style="background:var(--accent);border-color:var(--accent);color:#fff"><svg viewBox="0 0 24 24" class="h-[60%] w-[60%]"><path d="M6 12.5l3.5 3.5L18 8" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"></path></svg></span>
              <span aria-hidden="true" class="flex h-6 w-6 items-center justify-center rounded-full border-2" style="background:var(--accent);border-color:var(--accent);color:#fff"><svg viewBox="0 0 24 24" class="h-[60%] w-[60%]"><path d="M6 12.5l3.5 3.5L18 8" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"></path></svg></span>
              <span aria-hidden="true" class="flex h-6 w-6 items-center justify-center rounded-full border-2" style="background:var(--accent);border-color:var(--accent);color:#fff"><svg viewBox="0 0 24 24" class="h-[60%] w-[60%]"><path d="M6 12.5l3.5 3.5L18 8" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"></path></svg></span>
              <span aria-hidden="true" class="flex h-6 w-6 items-center justify-center rounded-full border-2" style="background:var(--accent);border-color:var(--accent);color:#fff"><svg viewBox="0 0 24 24" class="h-[60%] w-[60%]"><path d="M6 12.5l3.5 3.5L18 8" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"></path></svg></span>
              <span aria-hidden="true" class="flex h-6 w-6 items-center justify-center rounded-full border-2" style="background:var(--accent);border-color:var(--accent);color:#fff"><svg viewBox="0 0 24 24" class="h-[60%] w-[60%]"><path d="M6 12.5l3.5 3.5L18 8" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"></path></svg></span>
              <span aria-hidden="true" class="flex h-6 w-6 items-center justify-center rounded-full border-2" style="background:var(--accent);border-color:var(--accent);color:#fff"><svg viewBox="0 0 24 24" class="h-[60%] w-[60%]"><path d="M6 12.5l3.5 3.5L18 8" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"></path></svg></span>
              <span aria-hidden="true" class="flex h-6 w-6 items-center justify-center rounded-full border-2" style="border-color:rgba(117,30,104,0.33)"></span>
              <span aria-hidden="true" class="flex h-6 w-6 items-center justify-center rounded-full border-2" style="border-color:rgba(117,30,104,0.33)"></span>
              <span aria-hidden="true" class="flex h-6 w-6 items-center justify-center rounded-full border-2" style="border-color:rgba(117,30,104,0.33)"></span>
              <span aria-hidden="true" class="flex h-6 w-6 items-center justify-center rounded-full border-2" style="border-color:rgba(117,30,104,0.33)"></span>
            </div>
          </div>
          <div class="mt-4 grid grid-cols-2 gap-2">
            <span class="inline-flex h-10 items-center justify-center rounded-full bg-ink text-sm font-medium text-cream">
              +1 sello
            </span>
            <span class="inline-flex h-10 items-center justify-center rounded-full border border-line text-sm font-medium text-ink-muted">
              Canjear
            </span>
          </div>
        </figure>
      </div>
    </section>

    <!-- PASO 5 -->
    <section class="mk-stage grid gap-8 py-12 md:grid-cols-[minmax(0,2fr)_minmax(0,5fr)_minmax(0,4fr)] md:gap-10 md:py-16">
      <div>
        <p class="text-sm font-medium text-ink-muted">
          05 — <span class="text-accent-strong">Recompensa</span>
        </p>
        <span class="mt-2 inline-block rounded-full bg-accent-soft px-2.5 py-0.5 text-xs font-medium text-accent-strong">
          Canje en caja
        </span>
      </div>
      <div class="min-w-0">
        <h2 class="text-2xl font-semibold tracking-tight md:text-3xl">
          5. Completa los sellos y canjea su premio.
        </h2>
        <p class="mt-2 max-w-prose text-ink-soft">
          Al llegar a la meta, el empleado toca &ldquo;Canjear&rdquo;, la tarjeta se reinicia sola y todo queda registrado en tu panel.
        </p>
      </div>
      <div class="flex min-w-0 md:justify-end">
        <figure class="w-full max-w-xs rounded-card border border-line bg-paper" aria-label="Vista previa de actividad">
          <ul class="divide-y divide-line text-sm">
            <li class="flex items-center justify-between gap-3 px-4 py-2.5">
              <span class="font-medium">Canjeado</span>
              <span class="font-mono text-ink-soft">ABCD-2345</span>
              <span class="text-ink-muted">Empleado</span>
            </li>
            <li class="flex items-center justify-between gap-3 px-4 py-2.5">
              <span class="font-medium">Premio ganado</span>
              <span class="font-mono text-ink-soft">ABCD-2345</span>
              <span class="text-ink-muted">Empleado</span>
            </li>
            <li class="flex items-center justify-between gap-3 px-4 py-2.5">
              <span class="font-medium">Sello +1</span>
              <span class="font-mono text-ink-soft">ABCD-2345</span>
              <span class="text-ink-muted">Empleado</span>
            </li>
            <li class="flex items-center justify-between gap-3 px-4 py-2.5">
              <span class="font-medium">Ajuste manual</span>
              <span class="font-mono text-ink-soft">QRST-7890</span>
              <span class="text-ink-muted">Dueño</span>
            </li>
          </ul>
        </figure>
      </div>
    </section>
  </div>

  <!-- =====================================================================
       3. BENEFICIOS — FRASES CORTAS Y DIRECTAS (SIN PÁRRAFOS LARGOS)
       ===================================================================== -->
  <section class="mx-auto w-full max-w-6xl px-5 py-16">
    <h2 class="text-3xl font-semibold tracking-tight md:text-4xl">Beneficios para tu negocio</h2>
    <dl class="mt-8 grid gap-x-10 gap-y-6 sm:grid-cols-2 md:grid-cols-3">
      <div class="border-t border-line pt-4">
        <dt class="font-semibold">Sin aplicaciones que descargar</dt>
        <dd class="mt-1 text-sm text-ink-soft">
          Un escaneo con la cámara y la tarjeta queda guardada en 5 segundos.
        </dd>
      </div>
      <div class="border-t border-line pt-4">
        <dt class="font-semibold">Apple Wallet y Google Wallet</dt>
        <dd class="mt-1 text-sm text-ink-soft">
          Notifica automáticamente en pantalla cuando el cliente pasa cerca de tu local.
        </dd>
      </div>
      <div class="border-t border-line pt-4">
        <dt class="font-semibold">No necesitas comprar equipos</dt>
        <dd class="mt-1 text-sm text-ink-soft">
          Cero lectores ni terminales especiales en mostrador.
        </dd>
      </div>
      <div class="border-t border-line pt-4">
        <dt class="font-semibold">Tus empleados usan cualquier celular</dt>
        <dd class="mt-1 text-sm text-ink-soft">
          Entran al escáner con un PIN de 6 dígitos sin crear cuentas.
        </dd>
      </div>
      <div class="border-t border-line pt-4">
        <dt class="font-semibold">Conoce la actividad de tus clientes</dt>
        <dd class="mt-1 text-sm text-ink-soft">
          Ve cada sello, canje y visita recurrente en tiempo real.
        </dd>
      </div>
      <div class="border-t border-line pt-4">
        <dt class="font-semibold">Personaliza con tu marca</dt>
        <dd class="mt-1 text-sm text-ink-soft">
          Tu logo, colores y enlace propio en la tarjeta y en el cartel.
        </dd>
      </div>
    </dl>
  </section>

  <!-- =====================================================================
       4. PRECIO ($500 MXN / MES) — VALOR CLARO AL INSTANTE
       ===================================================================== -->
  <section class="mx-auto w-full max-w-6xl px-5 py-16" id="precios">
    <div class="grid gap-10 md:grid-cols-[minmax(0,4fr)_minmax(0,7fr)] md:items-start">
      <div>
        <h2 class="text-3xl font-semibold tracking-tight md:text-4xl">Un solo precio claro</h2>
        <p class="mt-3 max-w-prose text-ink-soft">
          Con solo <strong>3 o 4 clientes que regresen una vez más al mes</strong> pagas toda la suscripción. Todo lo demás es ganancia para tu negocio.
        </p>
      </div>
      <div class="rounded-3xl border border-line bg-paper p-6 sm:p-8">
        <div class="flex flex-wrap items-baseline justify-between gap-3">
          <p class="text-5xl font-semibold tracking-tight">
            $500 <span class="text-lg font-normal text-ink-muted">MXN / mes</span>
          </p>
          <span class="rounded-full bg-accent-soft px-3 py-1 text-xs font-medium text-accent-strong">
            Sin plazos forzosos
          </span>
        </div>
        <ul class="mt-6 grid gap-3 text-sm text-ink-soft sm:grid-cols-2 sm:gap-x-8">
          <li class="flex gap-2.5">
            <span aria-hidden="true" class="mt-1.5 h-2.5 w-2.5 shrink-0 rounded-full bg-accent"></span>
            Apple Wallet, Google Wallet y tarjetas web
          </li>
          <li class="flex gap-2.5">
            <span aria-hidden="true" class="mt-1.5 h-2.5 w-2.5 shrink-0 rounded-full bg-accent"></span>
            Modo escaneo de empleado y auto-servicio
          </li>
          <li class="flex gap-2.5">
            <span aria-hidden="true" class="mt-1.5 h-2.5 w-2.5 shrink-0 rounded-full bg-accent"></span>
            Clientes, visitas y sellos ilimitados
          </li>
          <li class="flex gap-2.5">
            <span aria-hidden="true" class="mt-1.5 h-2.5 w-2.5 shrink-0 rounded-full bg-accent"></span>
            Cartel QR para mostrador listo para imprimir
          </li>
          <li class="flex gap-2.5">
            <span aria-hidden="true" class="mt-1.5 h-2.5 w-2.5 shrink-0 rounded-full bg-accent"></span>
            Panel de actividad y PINs para empleados
          </li>
          <li class="flex gap-2.5">
            <span aria-hidden="true" class="mt-1.5 h-2.5 w-2.5 shrink-0 rounded-full bg-accent"></span>
            Tu logo, fotos y colores corporativos
          </li>
        </ul>
        <div class="mt-8 flex flex-wrap items-center gap-4">
          <a
            class="inline-flex h-12 items-center rounded-full bg-ink px-6 text-base font-medium text-cream transition-colors hover:bg-black"
            href="/login"
          >
            Configura tu negocio
          </a>
          <span class="text-xs text-ink-muted">
            Cancela cuando quieras en 1 clic · $0 comisión por sello
          </span>
        </div>
      </div>
    </div>
  </section>

  <!-- =====================================================================
       5. PREGUNTAS FRECUENTES — CORTAS Y SIN REPETIR LO ANTERIOR
       ===================================================================== -->
  <section class="border-t border-line" id="faq">
    <div class="mx-auto w-full max-w-6xl px-5 py-16">
      <h2 class="text-3xl font-semibold tracking-tight md:text-4xl">Preguntas Frecuentes</h2>
      <dl class="mt-8 grid gap-x-10 gap-y-8 md:grid-cols-2">
        <div class="border-t border-line pt-5">
          <dt class="text-lg font-semibold">¿Qué evita que alguien se asigne sellos falsos?</dt>
